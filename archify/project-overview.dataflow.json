{
  "schema_version": 1,
  "diagram_type": "dataflow",
  "meta": {
    "title": "GitHub Profile Pipeline: Classic and Modern Views",
    "output": "project-overview.html",
    "viewBox": [
      1080,
      560
    ],
    "quality_profile": "showcase"
  },
  "stages": [
    {
      "label": "Inputs"
    },
    {
      "label": "Build"
    },
    {
      "label": "Review"
    },
    {
      "label": "Save"
    },
    {
      "label": "Live"
    }
  ],
  "nodes": [
    {
      "id": "prompts",
      "type": "external",
      "label": "Master Prompts",
      "sublabel": "banner + snake guides",
      "stage": 0,
      "row": 0,
      "tag": "2 docx"
    },
    {
      "id": "bio-photo",
      "type": "external",
      "label": "Bio + Photo",
      "sublabel": "facts and portrait",
      "stage": 0,
      "row": 1,
      "tag": "docx + PNG"
    },
    {
      "id": "playbook",
      "type": "external",
      "label": "Playbook",
      "sublabel": "five animated cards",
      "stage": 0,
      "row": 2,
      "tag": "PDF"
    },
    {
      "id": "classic-gen",
      "type": "backend",
      "label": "Classic Generator",
      "sublabel": "profile-build/",
      "stage": 1,
      "row": 0,
      "tag": "2 banners"
    },
    {
      "id": "modern-gen",
      "type": "backend",
      "label": "Modern Generator",
      "sublabel": "modern/build.py",
      "stage": 1,
      "row": 2,
      "tag": "10 SVGs"
    },
    {
      "id": "preview",
      "type": "security",
      "label": "Preview + Approval",
      "sublabel": "both views, local",
      "stage": 2,
      "row": 1,
      "tag": "you decide"
    },
    {
      "id": "repo",
      "type": "database",
      "label": "profile-repo",
      "sublabel": "local git clone",
      "stage": 3,
      "row": 1,
      "tag": "committed"
    },
    {
      "id": "profile",
      "type": "frontend",
      "label": "Modern View",
      "sublabel": "open by default",
      "stage": 4,
      "row": 0,
      "tag": "toggle"
    },
    {
      "id": "classic-page",
      "type": "frontend",
      "label": "Classic View",
      "sublabel": "same profile page",
      "stage": 4,
      "row": 1,
      "tag": "toggle"
    },
    {
      "id": "snake",
      "type": "cloud",
      "label": "Snake Workflow",
      "sublabel": "GitHub Actions",
      "stage": 4,
      "row": 2,
      "tag": "daily"
    }
  ],
  "flows": [
    {
      "id": "rules",
      "from": "prompts",
      "to": "classic-gen",
      "label": "design rules",
      "classification": "terminal banner",
      "variant": "default"
    },
    {
      "id": "to-classic",
      "from": "bio-photo",
      "to": "classic-gen",
      "label": "text-art portrait",
      "classification": "facts",
      "variant": "emphasis",
      "fromSide": "top",
      "toSide": "bottom",
      "via": [
        [
          100,
          214
        ],
        [
          315,
          214
        ]
      ]
    },
    {
      "id": "to-modern",
      "from": "bio-photo",
      "to": "modern-gen",
      "label": "edge-lit photo",
      "classification": "facts",
      "variant": "emphasis",
      "fromSide": "bottom",
      "toSide": "top",
      "via": [
        [
          100,
          328
        ],
        [
          315,
          328
        ]
      ]
    },
    {
      "id": "cards",
      "from": "playbook",
      "to": "modern-gen",
      "label": "card design",
      "classification": "navy, blue, crimson",
      "variant": "default"
    },
    {
      "id": "banners",
      "from": "classic-gen",
      "to": "preview",
      "label": "2 banners",
      "classification": "dark, light",
      "variant": "default"
    },
    {
      "id": "modern-files",
      "from": "modern-gen",
      "to": "preview",
      "label": "cards + README",
      "classification": "1 preview page",
      "variant": "emphasis"
    },
    {
      "id": "approved",
      "from": "preview",
      "to": "repo",
      "label": "approved, copied",
      "classification": "your yes",
      "variant": "security"
    },
    {
      "id": "push-profile",
      "from": "repo",
      "to": "profile",
      "label": "git push",
      "classification": "README.md",
      "variant": "emphasis",
      "fromSide": "top",
      "toSide": "left",
      "via": [
        [
          745,
          157
        ]
      ]
    },
    {
      "id": "push-classic",
      "from": "repo",
      "to": "classic-page",
      "label": "same README",
      "classification": "README.md",
      "variant": "default"
    },
    {
      "id": "trigger",
      "from": "repo",
      "to": "snake",
      "label": "runs daily",
      "classification": "and on push",
      "variant": "dashed",
      "fromSide": "bottom",
      "toSide": "left",
      "via": [
        [
          745,
          385
        ]
      ]
    },
    {
      "id": "switch",
      "from": "profile",
      "to": "classic-page",
      "label": "toggle",
      "classification": "in place",
      "variant": "emphasis",
      "labelAt": [
        960,
        214
      ]
    },
    {
      "id": "snake-svg",
      "from": "snake",
      "to": "classic-page",
      "label": "snake images",
      "classification": "output branch",
      "variant": "dashed",
      "labelAt": [
        960,
        328
      ]
    }
  ],
  "cards": [
    {
      "dot": "emerald",
      "title": "Two Views, One Profile",
      "items": [
        "Modern opens by default; tap the Classic bar to switch",
        "Both views share one page: opening one closes the other",
        "Classic text is carried over word for word"
      ]
    },
    {
      "dot": "rose",
      "title": "Build and Review",
      "items": [
        "Classic generator: text-art banners for dark and light mode",
        "Modern generator: banner, toggle bars and five animated cards",
        "Only your own bio facts; nothing pushed before your yes"
      ]
    },
    {
      "dot": "orange",
      "title": "Live and Housekeeping",
      "items": [
        "The snake grows as it eats and refreshes every day",
        "Each card is self-contained: fonts and photo inside, no scripts",
        "Project notes and the handbook keep the rebuild steps"
      ]
    }
  ]
}